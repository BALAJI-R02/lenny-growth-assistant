# ============================================================
# Lenny Growth Assistant — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Database ---
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lennypass          # REQUIRED: change in production
POSTGRES_DB=lennygrowth

# --- LLM Provider ---
# Options: ollama | anthropic | openai
LLM_PROVIDER=ollama                  # REQUIRED

# Model name (must match provider)
# Ollama examples: llama3.2, mistral, gemma2
# Anthropic examples: claude-3-haiku-20240307, claude-3-5-sonnet-20241022
# OpenAI examples: gpt-4o-mini, gpt-4o
MODEL_NAME=llama3.2                  # REQUIRED

# --- Ollama ---
OLLAMA_BASE_URL=http://host.docker.internal:11434  # REQUIRED when LLM_PROVIDER=ollama
                                                    # Windows/Mac: host.docker.internal works
                                                    # Linux: use host IP or run ollama on bridge

# --- Cloud API Keys (optional, used for fallback) ---
# ANTHROPIC_API_KEY=sk-ant-...       # OPTIONAL: enables Anthropic fallback
# OPENAI_API_KEY=sk-...             # OPTIONAL: enables OpenAI fallback

# --- Retrieval ---
RETRIEVAL_TOP_K=8                    # Number of chunks to retrieve
RETRIEVAL_MIN_SCORE=0.05             # Below this → NO INTEL FOUND

# --- Request Settings ---
LLM_TIMEOUT_SECONDS=120              # Request timeout

# --- Frontend ---
VITE_API_URL=http://localhost:8000   # Backend URL visible from browser

# --- Ingest ---
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
INGEST_MAX_EPISODES=60               # Cap to avoid slow ingest; 0 = unlimited
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Router ---
ROUTER_USE_LLM=false                 # Set true to use LLM for ambiguous routing

# --- Logging ---
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
